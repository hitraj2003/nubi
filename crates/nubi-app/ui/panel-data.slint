export struct FieldChoice { value: string, label: string, selected: bool }
export struct PanelField {
    key: string, label: string, description: string, section: string, kind: string,
    value: string, checked: bool, selected: int, options: [string], choices: [FieldChoice],
    minimum: int, maximum: int, number: int, hour: int, minute: int, enabled: bool, error: string,
    first: bool, last: bool,
    hours: [string], minutes: [string], minute-index: int,
}
export struct PanelAlert { time: string, provider: string, text: string, queued: bool, count: int }
export struct PanelRelease { title: string, date: string, notes: string, download: string, current: bool }
export struct CalendarDay { label: string, date: string }
// Page-switch choreography (owner, 2026-11-28; LottieFiles motion-design rules): the heading
// reveals out of a mask, card surfaces fade fast, then row contents cascade top to bottom.
// `live` keeps animation-tick() out of idle frames.
export global PageMotion {
    in-out property <bool> live;
    in-out property <bool> reduced;
    in-out property <duration> started;
    out property <float> elapsed: live && !reduced ? (animation-tick() - started) / 1ms : 4000;
    // Progress 0..1 for an element whose own delay grows with its y (0.35 ms/px, capped).
    public pure function reveal(y: length, base: float, span: float) -> float {
        return 1 - pow(1 - clamp((elapsed - base - min(max(y, 0px) / 1px * 0.35, 200)) / span, 0, 1), 4);
    }
}
export global PanelData {
    in property <bool> clock-24;
    in-out property <[PanelField]> fields;
    in-out property <[PanelAlert]> alerts;
    in-out property <[PanelRelease]> releases;
    in-out property <[string]> monitors: ["Display 1"];
    in-out property <[CalendarDay]> calendar;
    in-out property <string> calendar-title;
    in-out property <string> date-field;
    in-out property <string> pipe-error;
    in-out property <string> usage-age;
    in-out property <bool> release-loading;
    in-out property <string> release-status: "Loading…";
    in-out property <string> action-status;
    in-out property <bool> busy;
    in-out property <length> focus-y;
    in-out property <length> focus-height: 48px;
    in-out property <length> settings-y;
    in-out property <length> feed-y;
    in-out property <length> report-y;
    in-out property <bool> claude-hooks;
    in-out property <bool> codex-hooks;
    in-out property <bool> development;
    in-out property <bool> desktime-tab: true;
    in-out property <bool> report-open;
    in-out property <bool> report-fields;
    in-out property <bool> report-busy;
    in-out property <string> report-status;
    in-out property <string> report-text;
    in-out property <[PanelField]> report-rows;
    callback edit(string, string);
    callback picked-date(string, int, int, int);
    callback choice(string, string);
    callback remove-date(string, string);
    callback calendar-move(int);
    callback calendar-pick(string);
    callback capture(string, string, bool, bool, bool, bool) -> bool;
    callback action(string, string);
}
