import { Theme } from "theme.slint";
export { NativeAlert } from "alert.slint";
export { Theme }
export { IconFrames } from "icons.slint";
export { NativeLauncher } from "runtime.slint";
export { ParityPanel } from "panel.slint";
export { PanelData, PanelField, FieldChoice, PanelAlert, PanelRelease, CalendarDay } from "panel-data.slint";
export { Session, Fixture } from "fixture.slint";
export { NotchData, NotchUpdate, NotchSession, NotchProvider, UsageWindow, NotchRequest, RequestOption, DeskRow, DeskSection } from "notch-data.slint";
import { NotchData, NotchProvider } from "notch-data.slint";
import { Fixture } from "fixture.slint";
import { Arc, ProviderMark, SourceIcon, Hint } from "parity-widgets.slint";
import { LiveSessionRow, RequestCard, UpdateCard, NotchButton, NotchTip } from "notch-cards.slint";
import "../assets/Geist400.ttf";
import "../assets/Geist500.ttf";
import "../assets/Geist600.ttf";
import "../assets/NubiFigures.ttf";

component InlineNotice inherits Rectangle {
    in property <length> width-limit;
    private property <length> text-width: max(1px, self.width - 58px);
    private property <length> body-row-height: NotchData.alert-body == "" ? 0px : body-measure.preferred-height;
    private property <length> text-height: title-size.preferred-height + (root.body-row-height > 0px ? 1px + root.body-row-height : 0px);
    width: min(root.width-limit, 58px + max(title-size.preferred-width, body-width.preferred-width));
    height: max(28px, root.text-height) + 20px;
    title-size := Text { text: NotchData.alert-title; font-family: Theme.semibold; font-size: 13px; opacity: 0; }
    body-width := Text { text: NotchData.alert-body; font-size: 12px; opacity: 0; }
    body-measure := Text { text: NotchData.alert-body; width: root.text-width; font-size: 12px; wrap: word-wrap; max-lines: 2; overflow: elide; opacity: 0; }
    Rectangle {
        x: 10px; y: (parent.height - self.height) / 2; width: 28px; height: 28px; border-radius: 14px;
        background: NotchData.alert-kind == "done" ? Theme.ok.with-alpha(0.16) : NotchData.alert-kind == "permission" || NotchData.alert-kind == "question" ? Theme.warn.with-alpha(0.16) : Theme.info.with-alpha(0.18);
        Image { x: 7px; y: 7px; width: 14px; height: 14px;
            source: NotchData.alert-kind == "done" ? @image-url("../assets/notch-alert-success.svg") : NotchData.alert-kind == "permission" || NotchData.alert-kind == "question" ? @image-url("../assets/notch-alert-warning.svg") : @image-url("../assets/notch-alert-info.svg");
            colorize: NotchData.alert-kind == "done" ? Theme.ok : NotchData.alert-kind == "permission" || NotchData.alert-kind == "question" ? Theme.warn : Theme.info;
        }
    }
    Text { x: 46px; y: (root.height - root.text-height) / 2; width: root.text-width; height: title-size.preferred-height;
        text: NotchData.alert-title; font-family: Theme.semibold; font-size: 13px; color: Theme.ink; max-lines: 1; overflow: elide; }
    Text { x: 46px; y: (root.height - root.text-height) / 2 + title-size.preferred-height + 1px; width: root.text-width; height: root.body-row-height;
        text: NotchData.alert-body; font-size: 12px; color: Theme.ink-2; wrap: word-wrap; max-lines: 2; overflow: elide; }
    accessible-role: text;
    accessible-label: NotchData.alert-title + " " + NotchData.alert-body;
}

component ProviderRing inherits Rectangle {
    in property <NotchProvider> provider;
    in property <bool> side;
    in property <float> phase;
    in property <float> pulse-phase;
    in property <float> refresh-phase;
    in property <float> equalizer-phase;
    // Slint rounds Text.preferred-width to whole logical pixels. Measure at
    // 100x to retain CSS-like fractional advances before the final shell rounding.
    private property <bool> is-pct: root.provider.text != "…" && root.provider.text != "—" && root.provider.text != "";
    measure := Text { visible: false; text: root.provider.text; font-family: Theme.num; font-size: 1100px; font-weight: 500; }
    // Keep source advances for layout, but reserve the actual heavier ink bounds.
    ink-measure := Text { visible: false; text: root.provider.text; font-family: Theme.num;
        font-size: Theme.snap(root.side ? 10px : 11px); font-weight: Theme.notch-compact-weight; }
    width: root.side ? 30px : 36px + measure.preferred-width / 100; height: root.side ? 44px : 30px;
    Rectangle { x: 0px; y: 0px; width: 30px; height: 30px; opacity: root.provider.stale ? 0.5 : 1;
        if root.provider.has-week : Arc { width: 30px; height: 30px; percent: root.provider.week;
            radius: 14.4; stroke: 1.6; track: Theme.dark ? #ffffff14 : #1d1b1714; ink: Fixture.usage-color(root.provider.week, false); }
        Arc { width: 30px; height: 30px; percent: root.provider.session; ink: Fixture.usage-color(root.provider.session, true); }
        if root.provider.activity != "" : Rectangle { x: 0px; y: 0px; width: 30px; height: 30px;
            transform-rotation: root.provider.activity == "working" && !Theme.reduced ? root.phase * 360deg : 0deg;
            opacity: root.provider.activity == "attention" && !Theme.reduced ? 0.625 + 0.375 * cos(root.pulse-phase * 360deg) : 1;
            Arc { width: 30px; height: 30px; radius: 7.6; stroke: 1.4; track: transparent;
                percent: root.provider.activity == "working" ? 28 : 100;
                ink: root.provider.activity == "attention" ? Theme.warn : Theme.notch-activity; }
        }
        ProviderMark { x: Theme.snap(9.5px); y: Theme.snap(9.5px); width: Theme.snap(11px); height: Theme.snap(11px);
            provider: root.provider.provider; opacity: root.provider.session >= 100 ? 0.35 : 1; }
    }
    percent := Text { x: Theme.align(root.side ? (30px - self.width) / 2 : 36px, parent.absolute-position.x); y: Theme.align(root.side ? 32px : 0px, parent.absolute-position.y) + Theme.notch-compact-y; width: max(root.side ? 34px : measure.preferred-width / 100, ink-measure.preferred-width + 2 * Theme.pixel); height: Theme.snap(root.side ? 12px : 30px);
        text: root.is-pct ? round(root.provider.session) : root.provider.text; color: Theme.ink-2; font-family: Theme.num; font-size: Theme.snap(root.side ? 10px : 11px); font-weight: Theme.notch-compact-weight;
        vertical-alignment: center; horizontal-alignment: root.side ? center : left; }
    if root.is-pct : Text { x: root.side ? percent.x + (percent.width + num-measure.preferred-width) / 2 : percent.x + num-measure.preferred-width; y: percent.y; height: percent.height;
        text: "%"; color: Theme.ink-2; font-family: Theme.num; font-size: percent.font-size; font-weight: Theme.notch-compact-weight + 100; vertical-alignment: center; }
    num-measure := Text { visible: false; text: round(root.provider.session); font-family: Theme.num; font-size: percent.font-size; font-weight: Theme.notch-compact-weight; }
    pct-measure := Text { visible: false; text: "%"; font-family: Theme.num; font-size: percent.font-size; font-weight: Theme.notch-compact-weight + 100; }
    accessible-role: text; accessible-label: root.provider.name + ": " + root.provider.text + " of session";
}

component Pie inherits Rectangle {
    in property <float> percent;
    in property <bool> soft;
    width: 44px; height: 44px;
    Rectangle { x: Theme.snap(0.5px); y: Theme.snap(0.5px); width: Theme.snap(43px); height: Theme.snap(43px); border-radius: 22px; background: Theme.dark ? #ffffff1a : #1d1b171a; }
    if root.percent >= 100 : Rectangle { x: Theme.snap(0.5px); y: Theme.snap(0.5px); width: Theme.snap(43px); height: Theme.snap(43px); border-radius: 22px; background: Fixture.usage-color(root.percent, root.soft); }
    if root.percent > 0 && root.percent < 100 : Path { width: 44px; height: 44px; viewbox-width: 44; viewbox-height: 44;
        fill: Fixture.usage-color(root.percent, root.soft);
        MoveTo { x: 22; y: 22; } LineTo { x: 22; y: 0.5; }
        ArcTo { radius-x: 21.5; radius-y: 21.5; x: 22 + 21.5 * sin(root.percent * 3.6deg); y: 22 - 21.5 * cos(root.percent * 3.6deg); sweep: true; large-arc: root.percent > 50; }
        Close {} }
}

export component NotchWindow inherits Window {
    // Native placement owns the work-area size; fixed dimensions constrain winit
    // and separate the visible shape from the native mouse hit-test scene.
    title: "Nubi notch"; preferred-width: root.side ? 420px : 720px; preferred-height: root.side ? 860px : 700px;
    no-frame: true; always-on-top: true; background: transparent;
    default-font-family: Theme.font; default-font-size: 13px;
    in property <float> along: 145;
    in property <float> depth: 44;
    in property <float> corner: 16;
    in property <float> ear: 8;
    in property <bool> opened;
    in property <bool> ready;
    // top, bottom, left, right. Content remains upright on every edge.
    in property <int> edge;
    in property <float> offset;
    in property <float> expansion-offset;
    in property <int> view-mode: 1;
    in property <float> phase;
    in property <float> pulse-phase;
    in property <float> refresh-phase;
    in property <float> equalizer-phase;
    in property <float> content-opacity: 1;
    in property <length> open-height: 188px;
    out property <length> compact-width: max(NotchData.providers.length == 1 ? 56px : 120px,
        round(compact-layout.preferred-width / 1px) * 1px);
    in property <string> menu-key;
    in property <string> menu-error;
    in property <bool> menu-busy;
    in property <bool> compact-queued;
    in-out property <int> confirmation;
    in-out property <int> menu-index;
    in-out property <int> tab: 1;
    in property <float> tab-x;
    in property <float> tab-width;
    private property <int> focus-tab: -1;
    private property <int> tip-index: -1;
    private property <length> tab-tip-x;
    private property <[string]> tab-names: ["Waiting", "Sessions", "Usage", "DeskTime"];
    // Pane rise from old-nubi island.css: 6px up and fade in over 380ms on open and tab change,
    // rows staggered by 28ms. Ease approximates cubic-bezier(.22,1,.36,1) as ease-out quint.
    private property <duration> pane-born;
    private property <bool> pane-live;
    private property <float> pane-ms: self.pane-live ? (animation-tick() - self.pane-born) / 1ms : 10000;
    private property <float> pane-p: Theme.reduced ? 1 : 1 - pow(1 - clamp(self.pane-ms / 380, 0, 1), 5);
    function pane-rise() { self.pane-born = animation-tick(); self.pane-live = true; }
    pure function row-rise(i: int) -> float {
        Theme.reduced ? 1 : 1 - pow(1 - clamp((self.pane-ms - min(i, 8) * 28) / 380, 0, 1), 5)
    }
    changed tab => { self.pane-rise(); NotchData.request-error = ""; }
    // Action errors belong to the moment they happened: clear after 4 s and on tab change,
    // so a failed terminal jump never lingers onto the Waiting tab (owner, 2026-11-28).
    Timer { interval: 4s; running: NotchData.request-error != ""; triggered => { NotchData.request-error = ""; } }
    changed view-mode => { if self.view-mode == 3 { self.pane-rise(); } }
    Timer { interval: 100ms; running: root.pane-live; triggered => { if root.pane-ms > 700 { root.pane-live = false; } } }
    callback open-panel();
    callback refresh-usage();
    callback toggle-dnd();
    callback tab-selected(int);
    callback tab-geometry(float, float);
    callback pill-clicked();
    callback drag-start();
    out property <bool> typing: keys.has-focus;
    out property <bool> side: edge >= 2;
    out property <length> open-width: side ? min(360px, root.width - 24px) : min(root.tab == 2 && NotchData.providers.length <= 1 ? max(360px, tabs-strip.preferred-width + 140px) : 620px, root.width - 48px);
    in property <bool> inline-notifications;
    in property <bool> desk-available: false;
    in property <bool> alert-active;
    out property <length> notice-width: inline-pill.width;
    out property <length> notice-height: inline-pill.height;
    out property <length> banner-space: root.inline-notifications && root.alert-active ? inline-banner.height + 8px : 0px;
    out property <length> requests-content-height: max(42px, requests-layout.preferred-height + (NotchData.update.id == "" ? 0px : update-card.height + (NotchData.requests.length == 0 ? 0px : Theme.space)));
    out property <bool> update-card-held: update-card.held;
    // Animation settling is an acknowledgment rule, not a reason to pause a
    // readable notice. Only an actually clipped/hidden card holds its clock.
    out property <bool> update-card-visible: root.ready && root.opened && root.view-mode == 3 && root.tab == 0
        && root.content-opacity > 0.01 && NotchData.update.id != ""
        && update-card.absolute-position.y < min(viewport.absolute-position.y + viewport.height, root.shape-y + root.shape-height)
        && update-card.absolute-position.y + update-card.height > max(viewport.absolute-position.y, root.shape-y);
    // Acknowledge only a complete, settled card inside the visible scroll viewport.
    out property <bool> update-card-shown: root.update-card-visible
        && root.content-opacity >= 0.99 && NotchData.update.id != ""
        && update-card.absolute-position.y >= root.shape-y - Theme.pixel
        && update-card.absolute-position.y + update-card.height <= root.shape-y + root.shape-height + Theme.pixel
        && update-card.absolute-position.y >= viewport.absolute-position.y - Theme.pixel
        && update-card.absolute-position.y + update-card.height <= viewport.absolute-position.y + viewport.height + Theme.pixel;
    private property <length> shape-width: (side ? depth : along) * 1px;
    private property <length> shape-height: (side ? along : depth) * 1px;
    private property <length> shift: clamp((offset + expansion-offset) * 1px, -(side ? root.height - outline.height : root.width - outline.width) / 2, (side ? root.height - outline.height : root.width - outline.width) / 2);
    private property <length> shape-x: side ? edge == 2 ? 0px : root.width - shape-width : (root.width - shape-width) / 2 + shift;
    private property <length> shape-y: side ? (root.height - shape-height) / 2 + shift : edge == 0 ? 0px : root.height - shape-height;
    public pure function px(u: float, v: float) -> float { return side ? edge == 2 ? v : depth - v : u; }
    public pure function py(u: float, v: float) -> float { return side ? u : edge == 0 ? v : depth - v; }
    public function focus-menu() { keys.focus(); }
    public function focus-requests() { keys.focus(); }

    outline := Path {
        visible: root.ready;
        private property <float> a: root.along + 2 * e;
        private property <float> d: max(1, root.depth);
        private property <float> r: min(root.corner, d / 2, root.along / 2);
        private property <float> e: min(root.ear, max(0, d - r));
        x: root.side ? root.shape-x : root.shape-x - e * 1px;
        y: root.side ? root.shape-y - e * 1px : root.shape-y;
        width: (root.side ? d : a) * 1px; height: (root.side ? a : d) * 1px;
        fill: Theme.notch-bg;
        MoveTo { x: root.px(0,0); y: root.py(0,0); }
        LineTo { x: root.px(outline.a,0); y: root.py(outline.a,0); }
        CubicTo { control-1-x: root.px(outline.a - outline.e * 0.62,0); control-1-y: root.py(outline.a - outline.e * 0.62,0);
            control-2-x: root.px(outline.a - outline.e,outline.e * 0.38); control-2-y: root.py(outline.a - outline.e,outline.e * 0.38);
            x: root.px(outline.a - outline.e,outline.e); y: root.py(outline.a - outline.e,outline.e); }
        LineTo { x: root.px(outline.a - outline.e,outline.d - outline.r); y: root.py(outline.a - outline.e,outline.d - outline.r); }
        CubicTo { control-1-x: root.px(outline.a - outline.e,outline.d - outline.r * 0.38); control-1-y: root.py(outline.a - outline.e,outline.d - outline.r * 0.38);
            control-2-x: root.px(outline.a - outline.e - outline.r * 0.38,outline.d); control-2-y: root.py(outline.a - outline.e - outline.r * 0.38,outline.d);
            x: root.px(outline.a - outline.e - outline.r,outline.d); y: root.py(outline.a - outline.e - outline.r,outline.d); }
        LineTo { x: root.px(outline.e + outline.r,outline.d); y: root.py(outline.e + outline.r,outline.d); }
        CubicTo { control-1-x: root.px(outline.e + outline.r * 0.38,outline.d); control-1-y: root.py(outline.e + outline.r * 0.38,outline.d);
            control-2-x: root.px(outline.e,outline.d - outline.r * 0.38); control-2-y: root.py(outline.e,outline.d - outline.r * 0.38);
            x: root.px(outline.e,outline.d - outline.r); y: root.py(outline.e,outline.d - outline.r); }
        LineTo { x: root.px(outline.e,outline.e); y: root.py(outline.e,outline.e); }
        CubicTo { control-1-x: root.px(outline.e,outline.e * 0.38); control-1-y: root.py(outline.e,outline.e * 0.38);
            control-2-x: root.px(outline.e * 0.62,0); control-2-y: root.py(outline.e * 0.62,0); x: root.px(0,0); y: root.py(0,0); }
        Close {}
    }
    keys := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.menu-key == "" { return reject; }
            if event.text == Key.Escape { NotchData.close-menu(); return accept; }
            if event.text == Key.Tab && root.confirmation == 0 { NotchData.close-menu(); return reject; }
            if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab {
                root.menu-index = mod(root.menu-index + (event.text == Key.UpArrow || event.modifiers.shift ? (root.confirmation == 0 ? 3 : 1) : 1),root.confirmation == 0 ? 4 : 2); return accept;
            }
            if event.text == Key.Home { root.menu-index = 0; return accept; }
            if event.text == Key.End { root.menu-index = root.confirmation == 0 ? 3 : 1; return accept; }
            if event.text == " " || event.text == "\n" { root.menu-select(root.menu-index); return accept; }
            return reject;
        }
        key-pressed(event) => { if event.text == Key.Escape { root.tip-index = -1; NotchData.detail-tip = ""; NotchData.close-menu(); return accept; } return reject; }
        Rectangle { visible: root.ready; x: root.shape-x; y: root.shape-y; width: root.shape-width; height: root.shape-height; clip: true;
            Rectangle { visible: root.view-mode == 1; x: root.side ? 0px : (parent.width - root.compact-width) / 2; y: root.side ? (parent.height - self.height) / 2 : 0px;
                width: root.side ? 46px : root.compact-width; height: root.side ? NotchData.providers.length * 54px + 14px + (NotchData.pending-count + NotchData.missed-count > 0 ? 26px : 0px) : 44px;
                pill := TouchArea { clicked => { root.pill-clicked(); } pointer-event(event) => { if event.kind == down && event.button == left { root.drag-start(); } } }
                for provider[index] in NotchData.providers : ProviderRing {
                    visible: root.side; x: 8px; y: 12px + index * 54px;
                    provider: provider; side: true; phase: root.phase; pulse-phase: root.pulse-phase;
                }
                compact-layout := HorizontalLayout {
                    visible: !root.side; x: 0px; y: 7px; height: 30px;
                    padding-left: 10px; padding-right: 10px; spacing: 12px;
                    HorizontalLayout { spacing: 8px;
                    for provider in NotchData.providers : ProviderRing {
                        provider: provider; side: false; phase: root.phase; pulse-phase: root.pulse-phase;
                    }
                    if NotchData.compact-text != "" : Text {
                        text: NotchData.compact-text; color: Theme.ink-2; font-size: 12px;
                        vertical-alignment: center;
                    }
                    }
                    if NotchData.pending-count + NotchData.missed-count > 0 || NotchData.glance != "" : HorizontalLayout { spacing: 8px;
                    if NotchData.pending-count + NotchData.missed-count > 0 : VerticalLayout { alignment: center; Rectangle {
                        width: max(18px, badge.preferred-width + 12px); height: 18px;
                        border-radius: 9px; background: badge-touch.pressed ? Theme.warn.darker(0.12) : badge-touch.has-hover ? Theme.warn.brighter(0.08) : Theme.warn;
                        animate background { duration: Theme.reduced ? 0ms : 150ms; easing: ease-out; }
                        badge := Text { x: 0px; y: 0px; width: parent.width; height: parent.height;
                            text: NotchData.pending-count > 0 ? NotchData.pending-count : NotchData.missed-count;
                            color: Theme.notch-bg; font-family: Theme.num; font-size: Theme.snap(11px); font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center; }
                        badge-touch := TouchArea { mouse-cursor: pointer; clicked => { if NotchData.pending-count == 0 { NotchData.terminal(""); } else { root.pill-clicked(); } } }
                    } }
                    if NotchData.pending-count == 0 && NotchData.missed-count > 0 : VerticalLayout { alignment: center; NotchButton {
                        width: 18px; height: 18px; glyph: "close"; quiet: true; hint: "Dismiss"; clicked => { NotchData.dismiss(""); }
                    } }
                    if NotchData.pending-count + NotchData.missed-count == 0 && NotchData.glance != "" : Text {
                        text: NotchData.glance; color: Theme.ink-2; font-family: Theme.num; font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                }
                if root.side && NotchData.pending-count + NotchData.missed-count > 0 : Rectangle {
                    x: 14px; y: parent.height - 22px; width: 20px; height: 18px; border-radius: 9px;
                    background: side-badge-touch.pressed ? Theme.warn.darker(0.12) : side-badge-touch.has-hover ? Theme.warn.brighter(0.08) : Theme.warn;
                    animate background { duration: Theme.reduced ? 0ms : 150ms; easing: ease-out; }
                    Text { width: 100%; height: 100%; text: NotchData.pending-count > 0 ? NotchData.pending-count : NotchData.missed-count;
                        color: Theme.notch-bg; font-family: Theme.num; font-size: Theme.snap(11px); font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    side-badge-touch := TouchArea { mouse-cursor: pointer; clicked => { if NotchData.pending-count == 0 { NotchData.terminal(""); } else { root.pill-clicked(); } } }
                }
            }
            if root.view-mode == 0 : TouchArea { clicked => { root.pill-clicked(); } pointer-event(event) => { if event.kind == down { root.drag-start(); } } }
            inline-pill := InlineNotice {
                visible: root.view-mode == 2 && root.inline-notifications && root.alert-active;
                width-limit: max(64px, min(320px, root.width - 24px));
                x: root.side ? root.edge == 2 ? 0px : parent.width - self.width : (parent.width - self.width) / 2;
                y: root.side ? (parent.height - self.height) / 2 : root.edge == 1 ? parent.height - self.height : 0px;
                opacity: root.content-opacity;
            }
            Rectangle { visible: root.view-mode == 2 && !root.inline-notifications; x: (parent.width - 360px) / 2; y: 0px; width: 360px; height: 56px;
                Rectangle { x: 10px; y: 14px; width: 28px; height: 28px; border-radius: 14px;
                    background: NotchData.alert-kind == "done" ? Theme.ok.with-alpha(0.16) : NotchData.alert-kind == "permission" ? Theme.warn.with-alpha(0.16) : Theme.info.with-alpha(0.18);
                    Image { x: 7px; y: 7px; width: 14px; height: 14px;
                        // Kokonut-style pop: spring in from 60% on appear.
                        private property <bool> shown;
                        Timer { interval: 16ms; running: !parent.shown; triggered => { parent.shown = true; } }
                        transform-scale: self.shown || Theme.reduced ? 1 : 0.6; opacity: self.shown ? 1 : 0;
                        animate transform-scale { duration: Theme.reduced ? 0ms : 420ms; easing: cubic-bezier(0.34,1.56,0.64,1); }
                        animate opacity { duration: Theme.reduced ? 0ms : 150ms; }
                        source: NotchData.alert-kind == "done" ? @image-url("../assets/notch-alert-success.svg") : NotchData.alert-kind == "permission" ? @image-url("../assets/notch-alert-warning.svg") : @image-url("../assets/notch-alert-info.svg");
                        colorize: NotchData.alert-kind == "done" ? Theme.ok : NotchData.alert-kind == "permission" ? Theme.warn : Theme.info; }
                }
                Text { x: Theme.align(48px, parent.absolute-position.x); y: Theme.align(10px, parent.absolute-position.y); text: NotchData.alert-title; color: Theme.ink; font-family: Theme.semibold; font-weight: Theme.notch-title-weight + 100; }
                Text { x: Theme.align(48px, parent.absolute-position.x); y: Theme.align(29px, parent.absolute-position.y); width: 300px; text: NotchData.alert-body; overflow: elide; color: Theme.ink-2; font-size: Theme.snap(12px); font-weight: Theme.notch-body-weight; }
            }
            open-body := Rectangle { visible: root.view-mode == 3; opacity: root.content-opacity;
                x: (parent.width - root.open-width) / 2; y: root.edge == 1 ? parent.height - root.open-height : 0px;
                width: root.open-width; height: root.open-height;
                header := Rectangle { x: 12px; y: 12px; width: parent.width - 24px; height: 32px;
                    // Reserve the complete toolbar before allocating the narrow tab strip.
                    private property <length> icon-width: root.side ? 22px : 28px;
                    private property <length> icons-x: self.width - 3 * self.icon-width - 8px;
                    TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.drag-start(); } } }
                    Rectangle { x: root.tab-x * 1px; y: 2px; width: root.tab-width * 1px; height: 28px;
                        border-radius: 14px; background: Theme.notch-ink-12; }
                    tabs-strip := HorizontalLayout { x: 0px; y: 2px; height: 28px; spacing: 6px;
                        width: self.preferred-width;
                        for icon[index] in ["inbox", "sessions", "usage", "desktime"] : Rectangle {
                            private property <bool> selected: root.tab == index;
                            private property <bool> hot: tab-touch.has-hover || tab-key.has-focus;
                            changed hot => {
                                if self.hot { root.tab-tip-x = self.x; root.tip-index = index + 3; }
                                else if root.tip-index == index + 3 { root.tip-index = -1; }
                            }
                            changed selected => { if self.selected { root.tab-geometry(self.x / 1px, self.width / 1px); } }
                            changed x => { if self.selected { root.tab-geometry(self.x / 1px, self.width / 1px); } }
                            changed width => { if self.selected { root.tab-geometry(self.x / 1px, self.width / 1px); } }
                            private property <int> requested-focus: root.focus-tab;
                            changed requested-focus => { if root.focus-tab == index { tab-key.focus(); } }
                            visible: index != 3 || NotchData.desk-visible;
                            private property <length> badge-width: count.text == "" ? 0px : max(16px, count.preferred-width + 8px);
                            private property <length> label-space: selected ? tab-label.preferred-width + 6px : 0px;
                            width: 36px + label-space + (badge-width == 0px ? 0px : badge-width + 4px);
                            height: 28px;
                            border-radius: 14px; background: tab-touch.pressed ? Theme.notch-ink-14
                                : root.tab-width <= 0 && self.selected ? Theme.notch-ink-12
                                : tab-touch.has-hover && !self.selected ? Theme.row-hover : transparent;
                            animate background { duration: Theme.reduced ? 0ms : 150ms; easing: ease-out; }
                            transform-scale: tab-touch.pressed && !Theme.reduced ? 0.95 : 1;
                            animate transform-scale { duration: Theme.reduced ? 0ms : 220ms; easing: cubic-bezier(0.34,1.56,0.64,1); }
                            SourceIcon { x: Theme.align(10px, parent.absolute-position.x);
                                y: Theme.align(6px, parent.absolute-position.y); width: Theme.snap(16px); height: self.width;
                                name: icon; colorize: parent.selected || parent.hot ? Theme.ink : Theme.ink-2;
                                animate colorize { duration: Theme.reduced ? 0ms : 150ms; } }
                            tab-label := Text { x: 32px; height: 28px; vertical-alignment: center; text: parent.selected ? root.tab-names[index] : ""; color: Theme.ink; font-size: 12px; }
                            Rectangle { x: 30px + parent.label-space; y: 6px; height: 16px; width: parent.badge-width; border-radius: 8px;
                                background: index == 0 && NotchData.requests.length > 0 ? Theme.warn : Theme.notch-ink-14;
                                count := Text { x: Theme.align(4px, parent.absolute-position.x); y: Theme.align(0px, parent.absolute-position.y) + Theme.notch-badge-y; height: Theme.snap(16px); text: index == 0 && NotchData.requests.length > 0 ? NotchData.requests.length : index == 1 && NotchData.session-count > 0 ? NotchData.session-count : "";
                                    color: index == 0 ? Theme.notch-bg : root.tab == index || tab-touch.has-hover ? Theme.ink : Theme.ink-2; font-family: Theme.num; font-size: Theme.snap(10px); font-weight: Theme.notch-badge-weight; vertical-alignment: center; }
                            }
                            tab-touch := TouchArea { mouse-cursor: pointer; clicked => { NotchData.focus-input(); tab-key.focus(); root.tab = index; root.tab-selected(index); } }
                            tab-key := FocusScope { width: 0px; height: 0px; key-pressed(event) => {
                                if event.text == " " || event.text == "\n" { root.tab = index; root.tab-selected(index); return accept; }
                                if event.text == Key.Home || event.text == Key.End { root.tab = event.text == Key.Home ? 0 : NotchData.desk-visible ? 3 : 2; root.focus-tab = root.tab; root.tab-selected(root.tab); return accept; }
                                if event.text == Key.LeftArrow || event.text == Key.RightArrow { root.tab = clamp(index + (event.text == Key.LeftArrow ? -1 : 1),0,NotchData.desk-visible ? 3 : 2); root.focus-tab = root.tab; root.tab-selected(root.tab); return accept; } return reject;
                            } }
                            accessible-role: AccessibleRole.tab; accessible-label: root.tab-names[index]; accessible-checkable: true; accessible-checked: root.tab == index;
                            accessible-action-default => { root.tab = index; root.tab-selected(index); }
                        }
                    }
                    for icon[index] in ["refresh-usage", "dnd", "open-panel"] : Rectangle {
                        private property <bool> hot: icon-touch.has-hover || icon-key.has-focus;
                        changed hot => { if self.hot { root.tip-index = index; } else if root.tip-index == index { root.tip-index = -1; } }
                        border-width: icon-key.has-focus ? Theme.pixel * 2 : 0px; border-color: Theme.ink-3;
                        x: header.icons-x + index * (header.icon-width + 4px); y: 2px; width: header.icon-width; height: 28px; border-radius: 14px;
                        background: icon-touch.pressed ? Theme.row : icon-touch.has-hover ? Theme.row-hover : Theme.row-hover.transparentize(1);
                        animate background { duration: Theme.reduced ? 0ms : 150ms; }
                        // Press bounce from old-nubi motion.js pressable(): 0.95 on press, springs back on release.
                        transform-scale: icon-touch.pressed && !Theme.reduced ? 0.95 : 1;
                        animate transform-scale { duration: Theme.reduced ? 0ms : 220ms; easing: cubic-bezier(0.34,1.56,0.64,1); }
                        SourceIcon { x: Theme.snap((parent.width - 15px) / 2); y: Theme.snap(6.5px); width: Theme.snap(15px); height: Theme.snap(15px); name: icon;
                            artwork: index == 0 ? "notch-refresh-usage" : index == 1 ? NotchData.dnd ? "notch-dnd-on" : "notch-dnd" : "notch-open-panel";
                            colorize: index == 1 && NotchData.dnd ? Theme.warn : icon-touch.has-hover ? Theme.ink : Theme.ink-2;
                            animate colorize { duration: Theme.reduced ? 0ms : 150ms; }
                            spinning: index == 0 && (root.tab == 3 ? NotchData.desk-loading : NotchData.refreshing);
                            spin-angle: root.refresh-phase * 360deg; }
                        icon-touch := TouchArea { enabled: index != 0 || !(root.tab == 3 ? NotchData.desk-loading : NotchData.refreshing); mouse-cursor: pointer; clicked => {
                            NotchData.focus-input(); icon-key.focus();
                            if index == 0 { root.refresh-usage(); } else if index == 1 { root.toggle-dnd(); } else { root.open-panel(); }
                        } }
                        icon-key := FocusScope { width: 0px; height: 0px; enabled: index != 0 || !(root.tab == 3 ? NotchData.desk-loading : NotchData.refreshing); key-pressed(event) => { if event.text == " " || event.text == "\n" {
                            if index == 0 { root.refresh-usage(); } else if index == 1 { root.toggle-dnd(); } else { root.open-panel(); } return accept; } return reject; } }
                        accessible-role: button; accessible-label: index == 0 ? root.tab == 3 ? "Refresh DeskTime" : "Refresh usage now" : index == 1 ? "Do not disturb" : "Open Nubi window";
                        accessible-enabled: index != 0 || !(root.tab == 3 ? NotchData.desk-loading : NotchData.refreshing);
                        accessible-checkable: index == 1; accessible-checked: index == 1 && NotchData.dnd;
                        accessible-action-default => { if index == 0 { root.refresh-usage(); } else if index == 1 { root.toggle-dnd(); } else { root.open-panel(); } }
                    }
                }
                inline-banner := InlineNotice {
                    visible: root.banner-space > 0px;
                    width-limit: max(64px, min(320px, root.open-width - 24px));
                    x: 12px; y: 52px; background: Theme.row; border-radius: 12px;
                }
                viewport := Flickable {
                    private property <length> focus-position: NotchData.focus-y;
                    changed focus-position => {
                        if focus-position < self.absolute-position.y { self.content-y = min(0px, self.content-y + self.absolute-position.y - focus-position); }
                        else if focus-position + 40px > self.absolute-position.y + self.height { self.content-y = max(min(0px,self.height - self.content-height), self.content-y - (focus-position + 40px - self.absolute-position.y - self.height)); }
                    }
                    x: 12px; y: 52px + root.banner-space + (1 - root.pane-p) * 6px; width: root.open-width - 24px; height: max(0px, root.open-height - 52px - root.banner-space - 16px);
                    // Rows carry their own staggered fade; fading the whole viewport too would
                    // nest a second full-size offscreen layer per frame.
                    opacity: root.tab >= 2 ? root.pane-p : 1;
                    content-height: root.tab == 0 ? root.requests-content-height : root.tab == 1 ? sessions-layout.preferred-height : root.tab == 2 ? (root.side ? NotchData.providers.length : 1) * 120px : NotchData.desk-height;
                    interactive: root.menu-key == "";
                    requests-layout := VerticalLayout { visible: root.tab == 0; width: parent.width; spacing: Theme.space;
                        for request[index] in NotchData.requests : RequestCard { request: request; opacity: root.row-rise(index); }
                    }
                    update-card := UpdateCard { visible: root.tab == 0 && NotchData.update.id != "";
                        y: requests-layout.preferred-height + (NotchData.requests.length == 0 ? 0px : Theme.space);
                        width: parent.width;
                    }
                    if root.tab == 0 && NotchData.requests.length == 0 && NotchData.update.id == "" : Text { x: Theme.align(0px, parent.absolute-position.x); y: Theme.align(18px, parent.absolute-position.y); width: parent.width; text: "Nothing is waiting for you"; color: Theme.ink-3; font-size: 12px; horizontal-alignment: center; }
                    sessions-layout := VerticalLayout { visible: root.tab == 1; spacing: 0px;
                        for session[index] in NotchData.sessions : LiveSessionRow { session: session; side: root.side; phase: root.equalizer-phase; opacity: root.row-rise(index); }
                    }
                    if root.tab == 1 && NotchData.sessions.length == 0 : Text { x: Theme.align(0px, parent.absolute-position.x); y: Theme.align(18px, parent.absolute-position.y); width: parent.width; text: "No sessions yet. Start Claude Code or Codex."; color: Theme.ink-3; font-size: 12px; horizontal-alignment: center; }
                    if root.tab == 2 : Rectangle {
                        for provider[index] in NotchData.providers : Rectangle {
                            x: root.side ? 0px : index * (parent.width + 8px) / NotchData.providers.length;
                            y: root.side ? index * 120px : 0px;
                            width: root.side ? parent.width : (parent.width - (NotchData.providers.length - 1) * 8px) / NotchData.providers.length;
                            height: 112px; border-radius: 16px; background: Theme.row;
                            ProviderMark { x: 16px; y: 16px; provider: provider.provider; }


                            Text { letter-spacing: Theme.notch-provider-spacing; x: Theme.align(40px, parent.absolute-position.x); y: Theme.align(16px, parent.absolute-position.y) + Theme.notch-title-y; height: Theme.snap(18.2px); text: provider.name; color: Theme.ink; font-size: Theme.snap(13px); font-family: Theme.semibold; font-weight: Theme.notch-title-weight; }
                            Text { x: Theme.align(100px, parent.absolute-position.x); y: Theme.align(17px, parent.absolute-position.y); width: parent.width - 116px; text: provider.status; color: Theme.ink-3; font-size: Theme.snap(11px); overflow: elide; horizontal-alignment: right; }
                            if provider.windows.length == 0 : Text { x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(46px, parent.absolute-position.y); width: parent.width - 32px; text: provider.message; color: Theme.ink-3; font-size: 12px; wrap: word-wrap; }
                            for usage[window] in provider.windows : Rectangle { x: 16px + window * (parent.width - 16px) / 2; y: 46.2px; width: (parent.width - 48px) / 2; height: 49.8px;




                                Pie { x: 0px; y: 3px; percent: usage.percent; soft: window == 0; }
                                big-num := Text { x: Theme.align(54px, parent.absolute-position.x); y: Theme.align(0px, parent.absolute-position.y) + Theme.notch-number-y; height: Theme.snap(17.6px); vertical-alignment: center; text: round(usage.percent); color: Theme.ink; font-family: Theme.num; font-size: Theme.snap(16px); font-weight: Theme.notch-number-weight; }
                                    Text { x: big-num.x + big-num.preferred-width; y: big-num.y; height: big-num.height; vertical-alignment: center; text: "%"; color: Theme.ink; font-family: Theme.num; font-size: Theme.snap(16px); font-weight: Theme.notch-number-weight + 100; }
                                Text { x: Theme.align(54px, parent.absolute-position.x); y: Theme.align(17.6px, parent.absolute-position.y) + Theme.notch-body-y; height: Theme.snap(16.8px); vertical-alignment: center; letter-spacing: Theme.notch-body-spacing; text: usage.label; color: Theme.ink-2; font-size: Theme.snap(12px); font-weight: Theme.notch-body-weight; }
                                Text { x: Theme.align(54px, parent.absolute-position.x); y: Theme.align(34.4px, parent.absolute-position.y) + Theme.notch-caption-y; height: Theme.snap(15.4px); vertical-alignment: center; letter-spacing: Theme.notch-caption-spacing; text: usage.reset; color: Theme.ink-3; font-size: Theme.snap(11px); font-weight: Theme.notch-caption-weight; }
                            }
                        }
                    }
                    if root.tab == 3 : Rectangle {
                        for section in NotchData.desk-sections : Rectangle {
                            x: section.column * (parent.width + 8px) / max(1,section.columns); y: section.y;
                            width: (parent.width - (max(1,section.columns) - 1) * 8px) / max(1,section.columns); height: section.height;
                            border-radius: 16px; background: Theme.row; opacity: NotchData.desk-loading ? 0.72 : 1;
                            Text { visible: section.view != "day"; x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(16px, parent.absolute-position.y); text: section.title; color: Theme.ink; font-family: Theme.semibold; font-weight: Theme.notch-title-weight; }
                            Text { visible: section.view != "day"; x: Theme.align(120px, parent.absolute-position.x); y: Theme.align(16px, parent.absolute-position.y); width: parent.width - 136px; text: section.note; color: Theme.ink-3; font-size: Theme.snap(11px); horizontal-alignment: right; }
                            Text { x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(section.view == "day" ? 16px : 40px, parent.absolute-position.y); text: section.big; color: section.over ? Theme.ok : Theme.ink; font-family: Theme.num; font-size: section.view == "day" ? 28px : 22px; font-weight: 600; }
                            Text { x: Theme.align(parent.width / 2, parent.absolute-position.x); y: Theme.align(section.view == "day" ? 24px : 48px, parent.absolute-position.y); text: section.caption; color: Theme.ink-2; font-size: Theme.snap(12px); font-weight: Theme.notch-body-weight; }
                            Rectangle { x: 16px; y: section.view == "day" ? 56px : 78px; width: parent.width - 32px; height: 6px; border-radius: 3px; background: Theme.notch-ink-12;
                                Rectangle { x: 0px; y: 0px; width: Theme.snap(parent.width * section.percent / 100); height: parent.height; border-radius: 3px; background: Theme.ok; }
                                if section.pace >= 0 : Rectangle { x: Theme.snap(parent.width * section.pace / 100); y: -3px; width: Theme.snap(2px); height: 12px; border-radius: 1px; background: Theme.ink-2; }
                            }
                            for row[index] in section.rows : Rectangle {
                                private property <bool> day: section.view == "day";
                                x: 16px + mod(index,section.row-columns) * (parent.width - 20px) / section.row-columns;
                                y: (day ? 78px : 96px) + floor(index / section.row-columns) * section.row-height;
                                width: (parent.width - 32px - (section.row-columns - 1) * 12px) / section.row-columns; height: section.row-height;
                                Text { x: Theme.align(0px, parent.absolute-position.x); y: Theme.align(0px, parent.absolute-position.y); text: row.label; color: parent.day ? Theme.ink-3 : Theme.ink-2; font-size: parent.day ? 11px : 12px; }
                                Text { x: Theme.align(parent.day ? 0px : parent.width / 2, parent.absolute-position.x); y: Theme.align(parent.day ? 15px : 0px, parent.absolute-position.y); width: parent.day ? parent.width : parent.width / 2; text: row.value;
                                    horizontal-alignment: parent.day ? left : right; color: row.tone == "pos" ? Theme.ok : row.tone == "neg" ? Theme.bad : Theme.ink; font-family: Theme.num; font-size: parent.day ? 13px : 12px; font-weight: 600; }
                                Text { x: Theme.align(0px, parent.absolute-position.x); y: Theme.align(parent.day ? 32px : 17px, parent.absolute-position.y); width: parent.width; text: row.note; color: Theme.ink-3; font-size: Theme.snap(11px); horizontal-alignment: parent.day ? left : right; overflow: elide; }
                            }
                        }
                        if NotchData.desk-sections.length == 0 : Rectangle { x: 0px; y: 0px; width: parent.width; height: 190px; border-radius: 16px; background: Theme.row;
                            Text { x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(20px, parent.absolute-position.y); width: parent.width - 32px; text: NotchData.desk-title; accessible-live-region: polite; color: Theme.ink; font-family: Theme.semibold; font-weight: Theme.notch-title-weight; horizontal-alignment: center; }
                            Text { visible: !NotchData.desk-loading; x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(50px, parent.absolute-position.y); width: parent.width - 32px; text: NotchData.desk-message; wrap: word-wrap; color: Theme.ink-2; font-size: 12px; horizontal-alignment: center; }
                            if NotchData.desk-loading : Rectangle { x: 16px; y: 54px; width: parent.width - 32px; height: 100px;
                                for i in [0,1,2] : Rectangle { y: i * 24px; width: parent.width * (i == 0 ? 0.6 : i == 1 ? 0.85 : 0.45); height: 12px; border-radius: 6px; background: Theme.notch-ink-12; }
                                HorizontalLayout { y: 84px; height: 3px; spacing: 4px;
                                    for step in [0,1,2,3] : Rectangle { width: 18px; height: 3px; border-radius: 2px; background: step <= NotchData.desk-step ? Theme.ok : Theme.notch-ink-12; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            if !NotchData.desk-loading : HorizontalLayout { x: 16px; y: 134px; width: parent.width - 32px; height: 28px; spacing: 8px;
                                NotchButton { text: NotchData.desk-retry ? "Try again" : "Log in with email"; primary: true; clicked => { NotchData.desk-action(NotchData.desk-retry ? "refresh" : "login"); } }
                                NotchButton { visible: !NotchData.desk-retry; text: "Get browser extension"; clicked => { NotchData.desk-action("extension_download"); } }
                            }
                        }
                    }
                }
                NotchTip { x: 16px; y: clamp(NotchData.detail-y - open-body.absolute-position.y + 6px, 12px, max(12px, parent.height - self.height - 16px));
                    text: NotchData.detail-tip; active: root.tab == 0 && root.menu-key == "" && NotchData.detail-tip != ""; }
                Hint { x: root.tip-index >= 3 ? 12px + root.tab-tip-x : max(12px, root.open-width - self.width - 16px);
                    y: root.tip-index >= 3 ? 42px : root.side ? 66px : 40px;
                    active: root.tip-index >= 0 && root.menu-key == ""; text: root.tip-index >= 3 ? root.tab-names[root.tip-index - 3] : root.tip-index == 0 ? (root.tab == 3 ? "Refresh DeskTime now" : "Refresh usage now") : root.tip-index == 1 ? "Do not disturb" : "Open Nubi window"; }
                if NotchData.request-error != "" : Text { x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(parent.height - 18px, parent.absolute-position.y); width: parent.width - 32px; text: NotchData.request-error; color: Theme.notch-bad; font-size: Theme.snap(11px); overflow: elide; accessible-live-region: polite; }
                if NotchData.refresh-error != "" : Text { x: Theme.align(16px, parent.absolute-position.x); y: Theme.align(parent.height - 18px, parent.absolute-position.y); width: parent.width - 32px; text: NotchData.refresh-error; color: Theme.warn; font-size: Theme.snap(11px); overflow: elide; accessible-live-region: polite; }
                if root.menu-key != "" : Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height;
                    TouchArea { clicked => { NotchData.close-menu(); } }
                    Rectangle { x: parent.width - 292px; y: 44px; width: 280px; height: root.confirmation == 0 ? 174px : 180px;
                        border-radius: 12px; background: Theme.notch-bg; border-width: Theme.pixel; border-color: Theme.line;
                        if root.confirmation == 0 : VerticalLayout { x: 8px; y: 8px; width: parent.width - 16px; spacing: 0px;
                            for label[index] in ["Jump", "New terminal", root.compact-queued ? "Cancel queued compact" : "Compact context", "Close"] : Rectangle { height: 36px; border-radius: 8px;
                                background: root.menu-index == index || item-touch.has-hover ? Theme.row-hover : transparent;
                                Text { x: Theme.align(12px, parent.absolute-position.x); y: Theme.align(0px, parent.absolute-position.y); height: Theme.snap(36px); text: label; color: index == 3 ? Theme.bad : Theme.ink; vertical-alignment: center; }
                                item-touch := TouchArea { enabled: !root.menu-busy; mouse-cursor: pointer; clicked => { root.menu-select(index); } }
                                accessible-role: button; accessible-label: label;
                            }
                        }
                        if root.confirmation != 0 : Rectangle { x: 16px; y: 16px; width: parent.width - 32px; height: 146px;
                            Text { text: root.confirmation == 1 ? "Close this session?" : "Compact context?"; color: Theme.ink; font-family: Theme.semibold; font-weight: Theme.notch-title-weight; }
                            Text { y: Theme.align(30px, parent.absolute-position.y); width: parent.width; text: root.confirmation == 1 ? "Stops this agent and its running commands. The terminal window stays open." : "Sends /compact when this session is idle. Keep the terminal prompt empty until it runs.";
                                wrap: word-wrap; color: Theme.ink-2; font-size: Theme.snap(12px); font-weight: Theme.notch-body-weight; }
                            HorizontalLayout { y: 104px; height: 28px; spacing: 8px;
                                NotchButton { text: "Cancel"; primary: root.menu-index == 0; clicked => { NotchData.close-menu(); } }
                                NotchButton { text: root.confirmation == 1 ? "Close session" : "Queue compact"; enabled: !root.menu-busy; primary: root.menu-index == 1;
                                    clicked => { NotchData.session-action(root.menu-key, root.confirmation == 1 ? "close" : "compact"); } }
                            }
                        }
                        Text { x: Theme.align(8px, parent.absolute-position.x); y: Theme.align(parent.height - 24px, parent.absolute-position.y); width: parent.width - 16px; text: root.menu-error; color: Theme.bad; font-size: Theme.snap(11px); overflow: elide; }
                    }
                }
            }
        }
    }
    function menu-select(index: int) {
        if root.menu-busy { return; }
        if root.confirmation != 0 {
            if index == 0 { NotchData.close-menu(); } else { NotchData.session-action(root.menu-key,root.confirmation == 1 ? "close" : "compact"); } return;
        }
        if index == 3 { root.confirmation = 1; root.menu-index = 0; }
        else if index == 2 && !root.compact-queued { root.confirmation = 2; root.menu-index = 0; }
        else { NotchData.session-action(root.menu-key,index == 0 ? "jump" : index == 1 ? "new" : "cancel-compact"); }
    }
}
