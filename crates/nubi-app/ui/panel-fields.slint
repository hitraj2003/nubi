import { Theme } from "theme.slint";
import { ControlGlyph } from "icons.slint";
import { PanelData, PanelField, PageMotion } from "panel-data.slint";
import { Action } from "parity-widgets.slint";
import { PanelInk, PanelToggle, PanelDate } from "panel-widgets.slint";

export component Caption inherits PanelInk { color: Theme.t2; font-size: 12px; wrap: word-wrap; }
export component Heading inherits PanelInk { font-family: Theme.num; font-size: 24px; font-weight: 500; height: 32px; }
component Shortcut inherits HorizontalLayout {
    in property <PanelField> field;
    private property <bool> recording;
    private property <string> live;
    spacing: 6px; alignment: end; height: 32px;
    PanelInk { text: root.recording ? (root.live == "" ? "Press keys…" : root.live) : root.field.value == "" ? "Off" : root.field.value; font-family: Theme.mono; }
    Action { text: root.recording ? "Cancel" : "Record"; enabled: root.field.enabled;
        clicked => { root.recording = !root.recording; root.live = ""; if root.recording { keys.focus(); } } }
    keys := FocusScope { width: 0px; height: 0px; enabled: root.recording;
        focus-changed-event => { if !self.has-focus { root.recording = false; } }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab { return reject; }
            if event.text == Key.Escape { root.recording = false; return accept; }
            root.live = (event.modifiers.control ? "Ctrl " : "") + (event.modifiers.alt ? "Alt " : "") + (event.modifiers.shift ? "Shift " : "") + (event.modifiers.meta ? "Win " : "");
            if PanelData.capture(root.field.key,event.text,event.modifiers.control,event.modifiers.alt,event.modifiers.shift,event.modifiers.meta) { root.recording = false; }
            return accept;
        }
        key-released(event) => {
            root.live = (event.modifiers.control ? "Ctrl " : "") + (event.modifiers.alt ? "Alt " : "") + (event.modifiers.shift ? "Shift " : "") + (event.modifiers.meta ? "Win " : "");
            return accept;
        }
    }
}
component TimeWheel inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <bool> period;
    in property <string> label;
    callback step(int);
    width: 56px; height: 140px; clip: true;
    for offset in [-2,-1,0,1,2] : PanelInk {
        private property <int> item: root.value + offset;
        x: 0px; y: (offset + 2) * 28px; width: root.width; height: 28px;
        text: item < root.minimum || item > root.maximum ? "" : root.period ? (item == 0 ? "AM" : "PM") : (item < 10 ? "0" : "") + item;
        horizontal-alignment: center; font-size: offset == 0 ? 16px : 13px;
        color: offset == 0 ? Theme.t1 : Theme.t2;
    }
    TouchArea {
        pointer-event(e) => { if e.kind == down { keys.focus(); } }
        clicked => { root.step(round((self.mouse-y - 14px) / 28px) - 2); }
        scroll-event(e) => { if e.delta-y != 0px { root.step(e.delta-y > 0px ? -1 : 1); } return accept; }
    }
    keys := FocusScope { width: 0px; height: 0px; key-pressed(e) => {
        if e.text == Key.UpArrow || e.text == Key.DownArrow { root.step(e.text == Key.UpArrow ? -1 : 1); return accept; } return reject; } }
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.acc; border-radius: 6px;
    accessible-role: spinbox; accessible-label: label; accessible-value: value;
    accessible-action-increment => { root.step(1); } accessible-action-decrement => { root.step(-1); }
}
component QuietTime inherits HorizontalLayout {
    in property <PanelField> field;
    private property <int> hour: field.hour - 1;
    private property <string> formatted: (hour < 10 ? "0" : "") + hour + ":" + (field.minute < 10 ? "0" : "") + field.minute;
    private property <int> chosen-hour;
    private property <int> chosen-minute;
    spacing: 8px; alignment: end; height: 32px;
    Rectangle { width: 72px; height: 32px; border-radius: 8px; background: Theme.card-2; border-width: 1px; border-color: entry.has-focus ? Theme.acc : Theme.line;
        entry := TextInput { width: 100%; height: 100%; single-line: true; color: Theme.t1; font-family: Theme.num; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center; text: root.formatted; accessible-label: root.field.label + " (HH:MM)";
            accepted => { PanelData.edit(root.field.key, "time=" + self.text); }
            changed has-focus => { if !self.has-focus && self.text != root.formatted { PanelData.edit(root.field.key,"time=" + self.text); } }
        }
    }
    Action { text: "Pick time"; clicked => { root.chosen-hour = root.hour; root.chosen-minute = root.field.minute; picker.show(); }
        picker := PopupWindow { x: parent.width - self.width; y: parent.height + 4px; width: PanelData.clock-24 ? 180px : 222px; height: 232px;
            Rectangle { background: Theme.card; border-color: Theme.line-2; border-width: 1px; border-radius: 12px;
                PanelInk { x: 12px; y: 6px; height: 24px; text: root.field.label; font-weight: 600; }
                Rectangle { x: 8px; y: 88px; width: parent.width - 16px; height: 28px; border-radius: 6px; background: Theme.card-2; }
                HorizontalLayout { y: 32px; height: 140px; width: parent.width; alignment: center;
                    TimeWheel { label: "Hour"; minimum: PanelData.clock-24 ? 0 : 1; maximum: PanelData.clock-24 ? 23 : 12;
                        value: PanelData.clock-24 ? root.chosen-hour : mod(root.chosen-hour + 11,12) + 1;
                        step(d) => { let h = clamp(self.value + d,self.minimum,self.maximum); root.chosen-hour = PanelData.clock-24 ? h : mod(h,12) + (root.chosen-hour >= 12 ? 12 : 0); } }
                    TimeWheel { label: "Minute"; maximum: 59; value: root.chosen-minute; step(d) => { root.chosen-minute = clamp(self.value + d,0,59); } }
                    if !PanelData.clock-24 : TimeWheel { label: "AM or PM"; period: true; maximum: 1; value: root.chosen-hour >= 12 ? 1 : 0;
                        step(d) => { root.chosen-hour = mod(root.chosen-hour,12) + 12 * clamp(self.value + d,0,1); } }
                }
                HorizontalLayout { x: 8px; y: 184px; width: parent.width - 16px; height: 32px; alignment: end; spacing: 6px;
                    Action { text: "Cancel"; quiet: true; clicked => { picker.close(); } }
                    Action { text: "OK"; primary: true; clicked => { picker.close(); PanelData.edit(root.field.key, "time=" + root.chosen-hour + ":" + root.chosen-minute); } }
                }
            }
        }
    }
}
component Dropdown inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int, string);
    private property <bool> open;
    private property <int> highlighted-index;
    out property <bool> has-focus: keys.has-focus || open;
    height: 32px; border-radius: 10px; background: touch.pressed ? Theme.card-3 : Theme.card-2;
    animate background { duration: Theme.reduced ? 0ms : 150ms; easing: ease-out; }
    border-width: keys.has-focus && !open ? 2px : 1px; border-color: keys.has-focus && !open ? Theme.acc : open || touch.has-hover ? Theme.line-2 : Theme.line;
    animate border-color { duration: Theme.reduced ? 0ms : 150ms; }
    opacity: enabled ? 1 : 0.5;
    width: min(220px, selected-label.preferred-width + 42px);
    selected-label := PanelInk { x: 12px; width: parent.width - 42px; text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : ""; font-size: 13px; overflow: elide; }
    ControlGlyph { x: parent.width - 26px; y: 9px; name: root.open ? "up" : "down";
        ink: touch.pressed || root.open ? Theme.acc : touch.has-hover ? Theme.t1 : Theme.t3; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.show-list(); } }
    keys := FocusScope { enabled: root.enabled; width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.show-list(); return accept; }
            if event.text == Key.DownArrow && root.current-index < root.model.length - 1 { root.selected(root.current-index + 1, root.model[root.current-index + 1]); return accept; }
            if event.text == Key.UpArrow && root.current-index > 0 { root.selected(root.current-index - 1, root.model[root.current-index - 1]); return accept; }
            return reject;
        }
    }
    forward-focus: keys;
    function show-list() {
        if root.enabled && root.model.length > 0 && !root.open {
            keys.focus();
            root.highlighted-index = clamp(root.current-index, 0, root.model.length - 1);
            root.open = true;
            list.show();
        }
    }
    function select-option(index: int) {
        if index >= 0 && index < root.model.length {
            let option = root.model[index];
            list.close();
            root.open = false;
            root.selected(index, option);
        }
    }
    list := PopupWindow { x: root.width - max(root.width, 160px); y: root.height + 6px; width: max(root.width, 160px);
        height: min(10px + root.model.length * 32px, 268px);
        close-policy: close-on-click-outside; forward-focus: menu-keys;
        menu-keys := FocusScope {
            width: 100%; height: 100%;
            focus-changed-event => { if !self.has-focus { root.open = false; } }
            key-pressed(event) => {
                if event.text == Key.Escape { list.close(); root.open = false; return accept; }
                if event.text == " " || event.text == "\n" { root.select-option(root.highlighted-index); return accept; }
                if event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End {
                    root.highlighted-index = event.text == Key.Home ? 0 : event.text == Key.End ? root.model.length - 1
                        : clamp(root.highlighted-index + (event.text == Key.DownArrow ? 1 : -1), 0, root.model.length - 1);
                    scroll.content-y = min(max(scroll.content-y, 10px + (root.highlighted-index + 1) * 32px - scroll.height), root.highlighted-index * 32px);
                    return accept;
                }
                return reject;
            }
        Rectangle { width: 100%; height: 100%; border-radius: 14px; background: Theme.card; clip: true;
            border-width: 1px; border-color: Theme.dark ? Theme.line-2 : Theme.line;
            drop-shadow-blur: Theme.high-contrast ? 0px : 28px; drop-shadow-offset-y: 16px; drop-shadow-color: Theme.dark ? #000000cc : #281e0a47;
            private property <bool> shown;
            Timer { interval: 16ms; running: true; triggered => { self.running = false; parent.shown = true; } }
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Theme.reduced ? 0ms : 150ms; }
            // Old-nubi `.dd ul`: drops in from translateY(-4px) scale(.97) on the spring curve.
            y: self.shown || Theme.reduced ? 0px : -4px;
            transform-scale: self.shown || Theme.reduced ? 1 : 0.97;
            transform-origin: { x: self.width, y: 0px };
            animate y, transform-scale { duration: Theme.reduced ? 0ms : 250ms; easing: cubic-bezier(0.34,1.56,0.64,1); }
            scroll := Flickable { width: 100%; height: 100%; content-width: self.width; content-height: items.preferred-height;
                init => { self.content-y = clamp(root.highlighted-index * 32px - 100px, 0px, max(0px, self.content-height - self.height)); }
            items := VerticalLayout { padding: 5px;
                for option[i] in root.model : Rectangle { height: 32px; border-radius: 8px;
                    // Selected option: accent-tinted row instead of a checkmark (owner, 2026-11-28).
                    background: i == root.current-index
                        ? (Theme.high-contrast ? Theme.acc : Theme.acc.transparentize(item.pressed ? 0.62 : item.has-hover || i == root.highlighted-index ? 0.70 : 0.78))
                        : item.pressed ? Theme.card-3 : item.has-hover || i == root.highlighted-index ? Theme.card-2 : transparent;
                    animate background { duration: Theme.reduced ? 0ms : 150ms; }
                    PanelInk { x: 10px; width: parent.width - 20px; text: option; font-weight: i == root.current-index ? 500 : 400; font-size: 13px; overflow: elide;
                        color: i == root.current-index && Theme.high-contrast ? Theme.acc-ink : Theme.t1; }
                    accessible-role: button; accessible-label: option;
                    accessible-action-default => { root.select-option(i); }
                    item := TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { root.select-option(i); } }
                }
            }
            }
        }
        }
    }
    accessible-role: combobox; accessible-label: root.label; accessible-enabled: root.enabled; accessible-expanded: root.open;
    accessible-action-default => { root.show-list(); }
}
component StepButton inherits Rectangle {
    in property <string> text; in property <bool> enabled: true; callback clicked();
    // Old-nubi `.stepper .btn.ghost`: 28px square, 10px radius, no fill until hover.
    width: 28px; height: 28px; border-radius: 10px;
    background: t.pressed ? Theme.card-3 : t.has-hover && enabled ? Theme.card-2 : transparent;
    animate background { duration: Theme.reduced ? 0ms : 150ms; easing: ease-out; }
    transform-scale: t.pressed && root.enabled && !Theme.reduced ? 0.96 : 1;
    animate transform-scale { duration: Theme.reduced ? 0ms : 200ms; easing: cubic-bezier(0.34,1.56,0.64,1); }
    opacity: enabled ? 1 : 0.4;
    ControlGlyph { name: root.text == "+" ? "plus" : "minus"; ink: t.has-hover || t.pressed ? Theme.t1 : Theme.t2; }
    t := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button; accessible-label: root.text == "+" ? "Increase" : "Decrease"; accessible-action-default => { root.clicked(); }
}
component Stepper inherits HorizontalLayout {
    in property <int> value; in property <int> minimum; in property <int> maximum; in property <string> label;
    callback edited(int);
    function commit() { if num.text.is-float() { root.edited(clamp(num.text.to-float().round(), root.minimum, root.maximum)); } num.text = root.value; }
    spacing: 2px; alignment: end;
    StepButton { text: "−"; enabled: root.value > root.minimum; clicked => { root.edited(max(root.minimum, root.value - 1)); } }
    // Old-nubi `input.num`: 44 x 32, 10px radius, filled, 1px line, 1.5px accent on focus.
    Rectangle { width: 44px; height: 32px; border-radius: 10px; background: Theme.card-2;
        border-width: num.has-focus ? 1.5px : 1px; border-color: num.has-focus ? Theme.acc : Theme.line;
        animate border-color { duration: Theme.reduced ? 0ms : 150ms; }
        num := TextInput { width: 100%; height: 100%; text: root.value; horizontal-alignment: center; vertical-alignment: center; font-family: Theme.num; font-size: 12px; color: Theme.t1; input-type: number; single-line: true;
            accepted => { root.commit(); }
            changed has-focus => { if !self.has-focus { root.commit(); } }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.edited(min(root.maximum, root.value + 1)); return accept; }
                if event.text == Key.DownArrow { root.edited(max(root.minimum, root.value - 1)); return accept; }
                return reject; } }
        accessible-role: spinbox; accessible-label: root.label; accessible-value: root.value;

    }
    StepButton { text: "+"; enabled: root.value < root.maximum; clicked => { root.edited(min(root.maximum, root.value + 1)); } }
}
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <bool> multiline;
    callback edited();
    min-height: 32px; border-radius: 10px; background: Theme.card-2;
    border-width: input.has-focus ? 1.5px : 1px; border-color: input.has-focus ? Theme.acc : Theme.line;
    animate border-color { duration: Theme.reduced ? 0ms : 150ms; }
    input := TextInput { x: 12px; y: root.multiline ? 8px : 0px; width: parent.width - 24px; height: root.multiline ? parent.height - 16px : parent.height;
        text <=> root.text; font-family: Theme.font; font-size: 13px; color: Theme.t1; selection-background-color: Theme.acc.transparentize(0.6);
        vertical-alignment: root.multiline ? top : center; wrap: root.multiline ? word-wrap : no-wrap; single-line: !root.multiline;
        accessible-label: root.label; edited => { root.edited(); } }
    forward-focus: input;
}
component Check inherits Rectangle {
    in property <string> text; in property <bool> checked; callback toggled();
    height: 28px;
    Rectangle { x: 0px; y: 6px; width: 16px; height: 16px; border-radius: 5px;
        background: root.checked ? (ck.pressed ? Theme.acc.darker(0.12) : Theme.acc) : ck.pressed ? Theme.card-3 : Theme.card-2;
        border-width: root.checked ? 0px : 1px;
        animate background { duration: Theme.reduced ? 0ms : 150ms; }
        if root.checked : ControlGlyph { width: 12px; height: 12px; name: "check"; ink: Theme.acc-ink; }
        border-color: ck-keys.has-focus ? Theme.acc : ck.has-hover ? Theme.line-2 : Theme.line;
    }
    PanelInk { x: 24px; width: parent.width - 24px; text: root.text; }
    ck := TouchArea { mouse-cursor: pointer; clicked => { ck-keys.focus(); root.toggled(); } }
    ck-keys := FocusScope { width: 0px; height: 0px; key-pressed(event) => { if event.text == " " { root.toggled(); return accept; } return reject; } }
    accessible-role: checkbox; accessible-label: root.text; accessible-checkable: true; accessible-checked: root.checked; accessible-action-default => { root.toggled(); }
}
export component FieldRow inherits Rectangle {
    in property <PanelField> field;
    private property <float> enter: PageMotion.reveal(self.y, 160, 320);
    height: body.preferred-height + (field.section == "" ? 0px : 40px);
    if field.section != "" : PanelInk { x: 0px; y: 10px * (1 - root.enter); opacity: root.enter; height: 32px; text: root.field.section; color: Theme.t2; font-weight: 500; }
    Rectangle { y: root.field.section == "" ? 0px : 40px; width: root.width; height: body.height; background: Theme.card; border-radius: 18px;
        if !root.field.first : Rectangle { x: 0px; y: 0px; height: 18px; width: parent.width; background: Theme.card; }
        if !root.field.last : Rectangle { y: parent.height - 18px; height: 18px; width: parent.width; background: Theme.card; }
        if !root.field.first : Rectangle { x: 20px; y: 0px; width: parent.width - 40px; height: 1px; background: Theme.line; }
    }
    body := VerticalLayout { y: (root.field.section == "" ? 0px : 40px) + 6px * (1 - root.enter); width: root.width; height: self.preferred-height; padding-top: 12px; padding-bottom: 12px; padding-left: 20px; padding-right: 20px; spacing: 8px;
        HorizontalLayout { spacing: 20px; height: max(32px, labels.preferred-height);
            labels := VerticalLayout { spacing: 2px; horizontal-stretch: 1;
                PanelInk { text: root.field.label; font-weight: 500; height: 18px; }
                if root.field.description != "" : Caption { text: root.field.description; min-height: 18px; }
            }
            if root.field.kind == "bool" : PanelToggle { changed has-focus => { if self.has-focus { PanelData.focus-y = self.absolute-position.y; } } checked: root.field.checked; label: root.field.label;
                toggled => { PanelData.edit(root.field.key,self.checked ? "true" : "false"); } }
            if root.field.kind == "shortcut" : PanelToggle { label: root.field.label; checked: root.field.value != "";
                toggled => { PanelData.edit(root.field.key, self.checked ? (root.field.key == "dnd_hotkey" ? "ctrl+alt+d" : "ctrl+shift+t") : ""); } }
            if root.field.kind == "select" || root.field.kind == "monitor" : Dropdown { changed has-focus => { if self.has-focus { PanelData.focus-y = self.absolute-position.y; } }
                model: root.field.options; current-index: root.field.selected; enabled: root.field.enabled;
                label: root.field.label; selected(i, value) => { PanelData.edit(root.field.key,"@" + i); }
            }
            if root.field.kind == "number" : HorizontalLayout { width: 142px; spacing: 6px; alignment: end;
                Stepper { minimum: root.field.minimum; maximum: root.field.maximum; value: root.field.number;
                    label: root.field.label; edited(value) => { PanelData.edit(root.field.key,value); } }
                Caption { width: 12px; text: "s"; }
            }
            if root.field.kind == "readonly" : PanelInk { width: 168px; text: "Notch"; horizontal-alignment: right; }
            if root.field.kind == "hour" : PanelToggle { label: root.field.label; checked: root.field.hour > 0;
                toggled => { PanelData.edit(root.field.key, self.checked ? (root.field.key == "quiet_start" ? "time=22:00" : "time=07:00") : ""); } }
            if root.field.kind == "time" : HorizontalLayout { horizontal-stretch: 0; spacing: 4px;
                Dropdown { model: root.field.hours; current-index: root.field.hour; label: root.field.label + " hour";
                    selected(i, value) => { PanelData.edit(root.field.key,"h:" + i); } }
                if root.field.kind == "time" || root.field.hour > 0 : PanelInk { width: 8px; text: ":"; horizontal-alignment: center; }
                if root.field.kind == "time" || root.field.hour > 0 : Dropdown { model: root.field.minutes; current-index: root.field.minute-index; label: root.field.label + " minute";
                    selected(i, value) => { PanelData.edit(root.field.key,"m:" + value); } }
                if root.field.key == "start_of_day" : Action { text: "Clear"; quiet: true; clicked => { PanelData.edit(root.field.key,""); } }
            }
        }
        if root.field.kind == "shortcut" && root.field.value != "" : Shortcut { field: root.field; }
        if root.field.kind == "hour" && root.field.hour > 0 : QuietTime { field: root.field; }
        if root.field.kind == "theme" : HorizontalLayout { spacing: 12px; height: 120px;
            for label[index] in root.field.options : Rectangle {
                border-radius: 12px; background: index == 0 ? #f4f2ee : index == 1 ? #121110 : Theme.canvas;
                border-width: root.field.selected == index || focus.has-focus ? 2px : 1px; border-color: root.field.selected == index || focus.has-focus ? Theme.acc : Theme.line-2;
                PanelInk { x: 14px; y: 12px; height: 18px; text: label; color: index == 0 ? #1d1b17 : index == 1 ? #f3efe7 : Theme.t1; font-weight: 500; }
                for row in [0,1,2] : Rectangle { x: 14px; y: 44px + row * 14px; width: parent.width - 28px - row * 15px; height: 8px; border-radius: 3px; background: index == 0 ? #e3dfd6 : index == 1 ? #3a3834 : Theme.card-3; }
                TouchArea { clicked => { focus.focus(); PanelData.edit(root.field.key,"@" + index); } }
                focus := FocusScope { focus-gained => { PanelData.focus-y = root.absolute-position.y; } width: 0px; height: 0px; key-pressed(event) => { if event.text == " " || event.text == "\n" { PanelData.edit(root.field.key,"@" + index); return accept; } return reject; } }
                accessible-role: button; accessible-label: root.field.label + ": " + label; accessible-checkable: true; accessible-checked: root.field.selected == index;
                accessible-action-default => { PanelData.edit(root.field.key,"@" + index); }
            }
        }
        if root.field.kind == "accent" : HorizontalLayout { height: 32px; spacing: 8px;
            for label[index] in root.field.options : Rectangle {
                width: 40px; height: 32px; border-radius: 10px; border-width: root.field.selected == index || accent-focus.has-focus ? 2px : 0px; border-color: Theme.acc;
                Rectangle { x: 8px; y: 4px; width: 24px; height: 24px; border-radius: 12px; background: index == 0 ? #f5c842 : index == 1 ? #d97757 : index == 2 ? #5b8def : index == 3 ? #3fb37a : index == 4 ? #9b7bf3 : Theme.t1; }
                TouchArea { clicked => { accent-focus.focus(); PanelData.edit(root.field.key,"@" + index); } }
                accent-focus := FocusScope { focus-gained => { PanelData.focus-y = root.absolute-position.y; } width: 0px; height: 0px; key-pressed(event) => { if event.text == " " || event.text == "\n" { PanelData.edit(root.field.key,"@" + index); return accept; } return reject; } }
                accessible-role: button; accessible-label: root.field.label + ": " + label; accessible-checkable: true; accessible-checked: root.field.selected == index;
                accessible-action-default => { PanelData.edit(root.field.key,"@" + index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.field.kind == "multi" : VerticalLayout { spacing: 4px;
            for choice in root.field.choices : Check { text: choice.label; checked: choice.selected;
                toggled => { PanelData.choice(root.field.key,choice.value); } }
        }
        if root.field.kind == "dates" : VerticalLayout { spacing: 6px;
            PanelDate { changed has-focus => { if self.has-focus { PanelData.focus-y = self.absolute-position.y; } } field: root.field.key; label: root.field.label; }
            if root.field.choices.length == 0 : Caption { text: "None"; height: 18px; }
            for choice in root.field.choices : HorizontalLayout { height: 32px;
                PanelInk { text: choice.label; }
                Action { text: "Remove " + choice.label; quiet: true; clicked => { PanelData.remove-date(root.field.key,choice.value); } }
            }
        }
        if root.field.kind == "time" && root.field.value == "" : Caption { text: "Not set"; height: 18px; }
        if root.field.kind == "text" : TextField { height: 32px; text: root.field.value; label: root.field.label; edited => { PanelData.edit(root.field.key,self.text); } }
        if root.field.kind == "textarea" : TextField { multiline: true; text: root.field.value; height: 74px; label: root.field.label; edited => { PanelData.edit(root.field.key,self.text); } }
        if root.field.error != "" : PanelInk { text: root.field.error; color: Theme.bad; wrap: word-wrap; min-height: 18px; }
    }
    // Veil instead of opacity: a translucent card-colored cover fades the row contents
    // without forcing an offscreen layer in the software renderer.
    if root.enter < 1 : Rectangle { y: root.field.section == "" ? 0px : 40px; width: root.width; height: body.height;
        background: Theme.card.transparentize(root.enter); border-radius: 18px; }
}
