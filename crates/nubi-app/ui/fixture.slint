// Live core models. Usage colors resolve through the original OKLCH scale in Rust.
export struct Session { key: string, name: string, provider: string, state: string, context: string, ago: string }
export global Fixture {
    in-out property <[Session]> sessions: [];
    in-out property <[float]> session-percent: [0,0];
    in-out property <[float]> week-percent: [0,0];
    in-out property <[string]> usage-text: ["?", "?"];
    in-out property <[string]> reset-labels: ["", "", "", ""];
    in-out property <[string]> alert-times: [];
    in-out property <[string]> alert-lines: [];
    pure callback usage-color(float, bool) -> color;
}
