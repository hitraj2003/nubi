{
  "manifest_version": 3,
  "name": "Nubi DeskTime connect",
  "version": "1.0.0",
  "description": "Lets Nubi read your DeskTime hours with the DeskTime session you already have in this browser.",
  "key": "",
  "permissions": ["alarms", "cookies", "nativeMessaging", "storage"],
  "host_permissions": ["https://desktime.com/*", "https://*.desktime.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Nubi DeskTime connect", "default_popup": "popup.html" }
}
