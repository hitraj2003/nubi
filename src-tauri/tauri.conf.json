{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nubi",
  "version": "0.1.1",
  "identifier": "dev.nubi.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "island",
        "url": "island.html",
        "width": 720,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 1080,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "panel",
        "title": "Nubi",
        "url": "panel.html",
        "width": 960,
        "height": 680,
        "visible": false,
        "minWidth": 760,
        "minHeight": 520,
        "skipTaskbar": true
      },
      {
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "label": "ring",
        "url": "ring.html",
        "width": 84,
        "height": 134
      },
      {
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "label": "ringtip",
        "url": "ringtip.html",
        "width": 260,
        "height": 200
      },
      {
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "label": "taskbar",
        "url": "taskbar.html",
        "width": 233,
        "height": 46
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RTMzRkI4NUJDNjVBMUUKUldRZVdzWmJ1RC9qbWRIMG5xOTlvRVd4WVgwR0xERGdwMFJsQkx0YVg0RDNTdTRncHhJOEw3cncK",
      "endpoints": [
        "https://github.com/hitraj2003/nubi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
