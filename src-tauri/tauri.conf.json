{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-overlay",
  "version": "0.1.0",
  "identifier": "dev.claude-overlay.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "width": 360,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
