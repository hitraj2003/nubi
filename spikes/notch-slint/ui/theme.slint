// Values and roles copied from ui/theme.css, notch surface, default yellow accent.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> notch-bg: dark ? #000000 : #fdfcfa;
    out property <color> ink: dark ? #ffffff : #1d1b17;
    out property <color> ink-2: dark ? #ffffff9e : #1d1b17b8;
    out property <color> ink-3: dark ? #ffffff61 : #1d1b1799;
    out property <color> row: dark ? #ffffff0f : #1d1b170f;
    out property <color> row-hover: dark ? #ffffff1a : #1d1b171a;
    out property <color> notch-ink-12: dark ? #ffffff1f : #1d1b171f;
    out property <color> notch-ink-14: dark ? #ffffff24 : #1d1b1724;
    out property <color> track: dark ? #ffffff29 : #1d1b1729;
    out property <color> claude: #d97757;
    out property <color> codex: #6e9bef;
    out property <color> ok: dark ? #4cd964 : #24865a;
    out property <color> warn: dark ? #ffb340 : #a96900;
    out property <string> font: "Segoe UI Variable Text";
    out property <string> num: "Geist";
}
